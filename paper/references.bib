@inproceedings{Ara13,
	title        = {The Realm of the Pairings},
	author       = {Aranha, Diego F. and Barreto, Paulo S. L. M. and Longa, Patrick and Ricardini, Jefferson E.},
	year         = 2014,
	booktitle    = {Selected Areas in Cryptography -- SAC 2013},
	publisher    = {Springer Berlin Heidelberg},
	address      = {Berlin, Heidelberg},
	pages        = {3--25},
	isbn         = {978-3-662-43414-7},
	editor       = {Lange, Tanja and Lauter, Kristin and Lison{\v{e}}k, Petr},
	abstract     = {Bilinear maps, or pairings, initially proposed in a cryptologic context for cryptanalytic purposes, proved afterward to be an amazingly flexible and useful tool for the construction of cryptosystems with unique features. Yet, they are notoriously hard to implement efficiently, so that their effective deployment requires a careful choice of parameters and algorithms. In this paper we review the evolution of pairing-based cryptosystems, the development of efficient algorithms and the state of the art in pairing computation, and the challenges yet to be addressed on the subject, while also presenting some new algorithmic and implementation refinements in affine and projective coordinates.}
}
@inproceedings{GS10,
	title        = {Faster Squaring in the Cyclotomic Subgroup of Sixth Degree Extensions},
	author       = {Granger, Robert and Scott, Michael},
	year         = 2010,
	booktitle    = {Public Key Cryptography -- PKC 2010},
	publisher    = {Springer Berlin Heidelberg},
	address      = {Berlin, Heidelberg},
	pages        = {209--223},
	isbn         = {978-3-642-13013-7},
	editor       = {Nguyen, Phong Q. and Pointcheval, David},
	abstract     = {This paper describes an extremely efficient squaring operation in the so-called `cyclotomic subgroup' of {\$}{\backslash}mathbb{\{}F{\}}{\_}{\{}q^6{\}}^{\{}{\backslash}times{\}}{\$}, for {\$}q {\backslash}equiv 1 {\backslash}bmod{\{}6{\}}{\$}. Our result arises from considering the Weil restriction of scalars of this group from {\$}{\backslash}mathbb{\{}F{\}}{\_}{\{}q^6{\}}{\$}to {\$}{\backslash}mathbb{\{}F{\}}{\_}{\{}q^2{\}}{\$}, and provides efficiency improvements for both pairing-based and torus-based cryptographic protocols. In particular we argue that such fields are ideally suited for the latter when the field characteristic satisfies {\$}p {\backslash}equiv 1 {\backslash}pmod{\{}6{\}}{\$}, and since torus-based techniques can be applied to the former, we present a compelling argument for the adoption of a single approach to efficient field arithmetic for pairing-based cryptography.}
}
